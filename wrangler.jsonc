{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catstarry-site-staging",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "FEED_API",
      "service": "catstarry-feed-api-staging"
    }
  ]
}
