---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import { getVisibleProjects } from '../../components/projects/project-data';
import '../../components/projects/projects.css';
import { STAR_MAP_DESTINATION } from '../../lib/home-navigation';

const projects = getVisibleProjects();
---

<Base title="Projects" description="木下的成品项目索引。">
  <main class="projects-page" data-canvas="content">
    <div class="projects-page__shell">
      <header class="projects-page__header">
        <nav class="page-home-nav" aria-label="Projects 页面导航">
          <a class="page-home-link projects-page__back" href={STAR_MAP_DESTINATION} aria-label="返回星图">
            <span aria-hidden="true">←</span>
            <span>返回星图</span>
          </a>
        </nav>
        <p class="projects-page__eyebrow">SELECTED WORKS</p>
        <h1>Projects</h1>
        <p class="projects-page__intro">
          一些做过、还在继续做的东西。
        </p>
      </header>

      {projects.length > 0 ? (
        <section class="projects-grid" aria-label="项目列表">
          {projects.map((project) => <ProjectCard project={project} />)}
        </section>
      ) : (
        <section class="projects-empty" aria-live="polite">
          <p>暂时还没有公开的项目。</p>
        </section>
      )}
    </div>
  </main>
</Base>
