---
export const prerender = false;

import FeedAdmin from '../../components/feed/FeedAdmin';
import BlogLifecycleAdmin from '../../components/blog/BlogLifecycleAdmin';
import FeedLayout from '../../layouts/FeedLayout.astro';
import { publicFeedApiBase } from '../../lib/feed-api';
import { fetchOwnerApi, readOwnerSession } from '../../lib/server/owner-auth';
import type { BlogLifecycleEntry, PaginatedResponse, TimelineEntry } from '../../../shared/types';

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

let unavailable = '';
const auth = await readOwnerSession(Astro.request);
if (auth.state === 'unavailable') unavailable = '管理服务暂时不可用，请稍后重试。';
if (auth.state === 'unauthenticated') return Astro.redirect('/feed/');

let initial: PaginatedResponse<TimelineEntry> = { items: [], cursor: null, has_more: false };
let blogEntries: BlogLifecycleEntry[] = [];
let initialError = '';
if (!unavailable) {
  try {
    const [listResponse, blogResponse] = await Promise.all([
      fetchOwnerApi(Astro.request, '/api/feed/admin?limit=20'),
      fetchOwnerApi(Astro.request, '/api/blog/admin/publications'),
    ]);
    if (listResponse.ok) initial = await listResponse.json() as PaginatedResponse<TimelineEntry>;
    else initialError = '管理列表暂时无法读取，请重试。';
    if (blogResponse.ok) blogEntries = (await blogResponse.json() as { entries: BlogLifecycleEntry[] }).entries;
    else initialError ||= 'Blog 发布状态暂时无法读取，请重试。';
  } catch {
    initialError = '管理列表暂时无法读取，请重试。';
  }
}
if (unavailable) Astro.response.status = 503;
---

<FeedLayout title="Feed 管理" description="管理公开 Feed 内容。" canonicalPath="/feed/admin/">
  <header class="feed-header"><a class="feed-admin-back" href="/feed/">← 返回 Feed</a><p class="feed-eyebrow">PRIVATE MANAGEMENT</p><h1>Feed 管理</h1><p>隐藏、恢复或删除属于原生发布内容的记录。</p></header>
  {unavailable
    ? <p class="feed-state--error" role="alert">{unavailable}</p>
    : <>
        <BlogLifecycleAdmin client:load initial={blogEntries} />
        <FeedAdmin client:load apiBase={publicFeedApiBase()} initial={initial} initialError={initialError} />
      </>}
</FeedLayout>
