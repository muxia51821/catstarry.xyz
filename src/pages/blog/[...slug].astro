---
export const prerender = false;

import { getCollection, render } from 'astro:content';
import ArticleFooter from '../../components/ArticleFooter';
import ViewCounter from '../../components/ViewCounter';
import ViewTracker from '../../components/ViewTracker';
import BlogArchive from '../../components/blog/BlogArchive.astro';
import Base from '../../layouts/Base.astro';
import '../../styles/blog.css';
import { formatBlogDate, getPageCount, getPagePosts, getPostSlug, getPostUrl, sortPostsByDate } from '../../lib/blog';
import { shanghaiDayKey } from '../../../../shared/shanghai-time';
import { getCategoryLabel } from '../../lib/category';
import { filterPublishedBlogPosts } from '../../lib/server/blog-lifecycle';

const publicPosts = await filterPublishedBlogPosts(Astro.request, await getCollection('blog'));
if (!publicPosts) Astro.response.status = 503;
const posts = sortPostsByDate(publicPosts ?? []);
const segment = Astro.params.slug ?? '';
const page = /^\d+$/.test(segment) ? Number(segment) : null;
const pageCount = getPageCount(posts.length);
const post = page === null ? posts.find((entry) => getPostSlug(entry) === segment) : undefined;
if (publicPosts && ((page !== null && (page < 2 || page > pageCount)) || (page === null && !post))) Astro.response.status = 404;
const rendered = post ? await render(post) : undefined;
const canonicalUrl = post ? new URL(getPostUrl(post), Astro.site).href : '';
const postIndex = post ? posts.findIndex((entry) => getPostSlug(entry) === getPostSlug(post)) : -1;
const newerPost = postIndex > 0 ? posts[postIndex - 1] : undefined;
const olderPost = postIndex >= 0 ? posts[postIndex + 1] : undefined;
---

{!publicPosts ? (
  <Base title="Blog 暂时不可用"><main class="blog-page" data-canvas="content"><p role="alert">Blog 暂时无法读取，请稍后重试。</p></main></Base>
) : post && rendered ? (
  <Base title={post.data.title} description={post.data.description}>
    <meta slot="head" property="og:type" content="article" />
    <meta slot="head" name="twitter:card" content="summary" />
    <link slot="head" rel="alternate" type="application/rss+xml" title="catstarry.xyz · 博客 RSS" href="/blog/rss.xml" />
    <main class="blog-page blog-page--reading" data-canvas="content">
      <nav class="blog-reading-nav" aria-label="文章导航"><a class="blog-reading-nav__return" href="/blog/"><span aria-hidden="true">←</span><span>返回博客</span></a></nav>
      <article class="blog-article">
        <div class="blog-article__paper">
          <header class="blog-article__header">
            <a class="blog-article__category" href={`/blog/category/${post.data.category}/`}>{getCategoryLabel(post.data.category)}</a>
            <h1>{post.data.title}</h1><p class="blog-article__deck">{post.data.description}</p>
            <div class="blog-article__meta" aria-label="文章信息"><time datetime={shanghaiDayKey(post.data.date)}>{formatBlogDate(post.data.date)}</time><ViewTracker slug={getPostSlug(post)} client:load /><ViewCounter slug={getPostSlug(post)} client:load /></div>
          </header>
          <div class="blog-prose"><rendered.Content /></div>
          {post.data.tags.length > 0 && <footer class="blog-article__tags" aria-label="文章标签">{post.data.tags.map((tag) => <a href={`/blog/tag/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</footer>}
        </div>
        {(newerPost || olderPost) && <nav class:list={['blog-prev-next', { 'blog-prev-next--only-newer': !olderPost, 'blog-prev-next--only-older': !newerPost }]} aria-label="相邻文章">{newerPost && <a class="blog-prev-next__newer" href={getPostUrl(newerPost)}><span>上一篇</span><strong>{newerPost.data.title}</strong></a>}{olderPost && <a class="blog-prev-next__older" href={getPostUrl(olderPost)}><span>下一篇</span><strong>{olderPost.data.title}</strong></a>}</nav>}
        <footer class="blog-article__footer"><a class="blog-article__back" href="/blog/">← 返回博客列表</a></footer>
        <ArticleFooter title={post.data.title} slug={getPostSlug(post)} url={canonicalUrl} client:load />
      </article>
    </main>
  </Base>
) : page !== null && page >= 2 && page <= pageCount ? (
  <Base title="博客" description="木下的个人博客，写技术、生活与观点。"><BlogArchive title="博客" posts={getPagePosts(posts, page)} currentPage={page} pageCount={pageCount} basePath="/blog" /></Base>
) : <Base title="未找到文章"><main class="blog-page" data-canvas="content"><p>没有找到这篇文章。</p></main></Base>}
