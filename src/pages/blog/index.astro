---
export const prerender = false;

import { getCollection } from 'astro:content';
import BlogArchive from '../../components/blog/BlogArchive.astro';
import Base from '../../layouts/Base.astro';
import { getPageCount, getPagePosts, sortPostsByDate } from '../../lib/blog';
import { filterPublishedBlogPosts } from '../../lib/server/blog-lifecycle';

const publicPosts = await filterPublishedBlogPosts(Astro.request, await getCollection('blog'));
if (!publicPosts) Astro.response.status = 503;
const posts = sortPostsByDate(publicPosts ?? []);
---

<Base title="博客" description="木下的个人博客，写技术、生活与观点。">
  <link slot="head" rel="alternate" type="application/rss+xml" title="catstarry.xyz · 博客 RSS" href="/blog/rss.xml" />
  {publicPosts ? <BlogArchive
    title="博客"
    posts={getPagePosts(posts, 1)}
    currentPage={1}
    pageCount={getPageCount(posts.length)}
    basePath="/blog"
  /> : <main class="blog-page" data-canvas="content"><p role="alert">Blog 暂时无法读取，请稍后重试。</p></main>}
</Base>
