---
export const prerender = false;

import { getCollection } from 'astro:content';
import BlogArchive from '../../../components/blog/BlogArchive.astro';
import Base from '../../../layouts/Base.astro';
import { CATEGORY_LABELS, getCategoryLabel, type Category } from '../../../lib/category';
import { getPageCount, getPagePosts, sortPostsByDate } from '../../../lib/blog';
import { filterPublishedBlogPosts } from '../../../lib/server/blog-lifecycle';

const publicPosts = await filterPublishedBlogPosts(Astro.request, await getCollection('blog'));
if (!publicPosts) Astro.response.status = 503;
const [rawCategory = '', rawPage] = (Astro.params.category ?? '').split('/');
const category = rawCategory as Category;
const currentPage = rawPage ? Number(rawPage) : 1;
const validCategory = Object.hasOwn(CATEGORY_LABELS, category);
const categoryPosts = validCategory ? sortPostsByDate(publicPosts ?? []).filter((post) => post.data.category === category) : [];
const pageCount = getPageCount(categoryPosts.length);
if (publicPosts && (!validCategory || !Number.isInteger(currentPage) || currentPage < 1 || currentPage > pageCount)) Astro.response.status = 404;
const label = validCategory ? getCategoryLabel(category) : '未知分类';
---

<Base title={`分类：${label}`} description={`${label}分类下的已发布文章。`}>
  {publicPosts && validCategory && currentPage <= pageCount
    ? <BlogArchive title={`分类：${label}`} posts={getPagePosts(categoryPosts, currentPage)} currentPage={currentPage} pageCount={pageCount} basePath={`/blog/category/${category}`} showBackLink={true} />
    : <main class="blog-page" data-canvas="content"><p role="alert">{publicPosts ? '没有找到这个分类。' : 'Blog 暂时无法读取，请稍后重试。'}</p></main>}
</Base>
