---
export const prerender = false;

import { getCollection } from 'astro:content';
import BlogArchive from '../../../components/blog/BlogArchive.astro';
import Base from '../../../layouts/Base.astro';
import { getPageCount, getPagePosts, sortPostsByDate } from '../../../lib/blog';
import { filterPublishedBlogPosts } from '../../../lib/server/blog-lifecycle';

const publicPosts = await filterPublishedBlogPosts(Astro.request, await getCollection('blog'));
if (!publicPosts) Astro.response.status = 503;
const segments = (Astro.params.tag ?? '').split('/');
const rawPage = segments.length > 1 && /^\d+$/.test(segments.at(-1) ?? '') ? Number(segments.pop()) : 1;
const tag = decodeURIComponent(segments.join('/'));
const tagPosts = sortPostsByDate(publicPosts ?? []).filter((post) => post.data.tags.includes(tag));
const pageCount = getPageCount(tagPosts.length);
if (publicPosts && (!tag || tagPosts.length === 0 || rawPage < 1 || rawPage > pageCount)) Astro.response.status = 404;
---

<Base title={`标签：${tag}`} description={`带有「${tag}」标签的已发布文章。`}>
  {publicPosts && tagPosts.length > 0 && rawPage <= pageCount
    ? <BlogArchive title={`标签：${tag}`} posts={getPagePosts(tagPosts, rawPage)} currentPage={rawPage} pageCount={pageCount} basePath={`/blog/tag/${encodeURIComponent(tag)}`} showBackLink={true} />
    : <main class="blog-page" data-canvas="content"><p role="alert">{publicPosts ? '没有找到这个标签。' : 'Blog 暂时无法读取，请稍后重试。'}</p></main>}
</Base>
