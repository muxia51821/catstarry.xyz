---
import { getCollection } from 'astro:content';
import BlogArchive from '../../../components/blog/BlogArchive.astro';
import Base from '../../../layouts/Base.astro';
import { getPageCount, getPagePosts, sortPostsByDate, type BlogPost } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = sortPostsByDate(await getCollection('blog', ({ data }) => !data.draft));
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.flatMap((tag) => {
    const tagPosts = posts.filter((post) => post.data.tags.includes(tag));
    const pageCount = getPageCount(tagPosts.length);
    return Array.from({ length: pageCount }, (_, index) => {
      const currentPage = index + 1;
      return {
        params: { tag: currentPage === 1 ? tag : `${tag}/${currentPage}` },
        props: { tag, tagPosts, currentPage, pageCount },
      };
    });
  });
}

const { tag, tagPosts, currentPage, pageCount } = Astro.props as {
  tag: string;
  tagPosts: BlogPost[];
  currentPage: number;
  pageCount: number;
};
---

<Base title={`标签：${tag}`} description={`带有「${tag}」标签的已发布文章。`}>
  <BlogArchive
    title={`标签：${tag}`}
    posts={getPagePosts(tagPosts, currentPage)}
    currentPage={currentPage}
    pageCount={pageCount}
    basePath={`/blog/tag/${encodeURIComponent(tag)}`}
    showBackLink={true}
  />
</Base>
