---
export const prerender = false;

import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import LearnNoteView from '../../../components/learn/LearnNoteView.astro';
import { noteFromEntry } from '../../../components/learn/learn-data';
import { loadPublicLearnNotes } from '../../../lib/server/learn-publications';
import '../../../components/learn/learn.css';

const entries = await getCollection('learn');
const entry = entries.find((candidate) => candidate.data.slug === Astro.params.slug);
if (!entry) return new Response('Learn note not found', { status: 404 });
const sourceNote = noteFromEntry(entry);
let note = sourceNote;
let allPublishedNotes = [];
if (sourceNote.state !== 'withdrawn') {
  const publicNotes = await loadPublicLearnNotes(Astro.request, entries);
  if (!publicNotes) return new Response('Learn publication service unavailable', { status: 503 });
  const publicNote = publicNotes.find((candidate) => candidate.slug === sourceNote.slug);
  if (!publicNote) return new Response('Learn note not found', { status: 404 });
  note = publicNote;
  allPublishedNotes = publicNotes;
}
const { Content, headings } = await render(entry);
---

<Base title={`${note.title} · Learn`} description={note.excerpt}>
  <main class="learn-detail-page" data-canvas="content">
    {note.state === 'withdrawn' && (
      <p class="learn-withdrawn-notice" role="status">此笔记已退出当前 Learn corpus；页面暂时保留用于历史链接。</p>
    )}
    <LearnNoteView note={note} allNotes={allPublishedNotes} Content={Content} headings={headings} />
  </main>
</Base>
