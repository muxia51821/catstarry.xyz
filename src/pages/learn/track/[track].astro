---
export const prerender = false;

import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import NoteRow from '../../../components/learn/NoteRow.astro';
import {
  getTrackDefinition,
  getTrackNotes,
  getTrackSections,
} from '../../../components/learn/learn-data';
import { loadPublicLearnNotes } from '../../../lib/server/learn-publications';
import '../../../components/learn/learn.css';

const trackSlug = Astro.params.track ?? '';
let track;
try {
  track = getTrackDefinition(trackSlug);
} catch {
  return new Response('Learn track not found', { status: 404 });
}
const publicNotes = await loadPublicLearnNotes(Astro.request, await getCollection('learn'));
if (!publicNotes) return new Response('Learn publication service unavailable', { status: 503 });
const notes = getTrackNotes(publicNotes, trackSlug);
if (notes.length === 0) return new Response('Learn track not found', { status: 404 });
const sections = getTrackSections(notes);
const unsectioned = notes.filter((note) => !note.section);
const sectionId = (section: string) => `section-${section.toLocaleLowerCase('zh-CN').replace(/[^a-z0-9\u3400-\u9fff]+/g, '-')}`;
---

<Base title={`${track.name} · Learn`} description={track.description}>
  <main class="learn-page learn-track-page" data-canvas="content">
    <div class="learn-track-shell">
      <header class="learn-track-header">
        <a class="learn-page__back" href="/learn/">← 返回 Learn</a>
        <h1>{track.name}</h1>
        <p>{track.description}</p>
      </header>

      {sections.length > 0 && (
        <nav class="learn-section-nav" aria-label="笔记分节">
          {sections.map((section) => <a href={`#${sectionId(section)}`}>{section}</a>)}
        </nav>
      )}

      <div class="learn-track-groups">
        {sections.map((section) => (
          <section class="learn-track-section" id={sectionId(section)} aria-labelledby={`${sectionId(section)}-title`}>
            <h2 id={`${sectionId(section)}-title`}>{section}</h2>
            <div class="learn-note-rows">
              {notes.filter((note) => note.section === section).map((note) => <NoteRow note={note} />)}
            </div>
          </section>
        ))}
        {unsectioned.length > 0 && (
          <section class="learn-track-section" aria-label="其他笔记">
            <div class="learn-note-rows">{unsectioned.map((note) => <NoteRow note={note} />)}</div>
          </section>
        )}
        {notes.length === 0 && <p class="learn-empty">这个 Track 还没有 Published Note。</p>}
      </div>
      <a class="learn-page__back learn-track-return" href="/learn/">← 返回 Learn</a>
    </div>
  </main>
</Base>
