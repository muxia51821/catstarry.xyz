---
export const prerender = false;

import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import LearnNoteView from '../../../components/learn/LearnNoteView.astro';
import { noteFromEntry } from '../../../components/learn/learn-data';
import { feedApiBase } from '../../../lib/feed-api';
import '../../../components/learn/learn.css';

const apiBase = feedApiBase(Astro.url.origin);
const previewHeaders = {
  'Cache-Control': 'private, no-store',
  Pragma: 'no-cache',
  'X-Robots-Tag': 'noindex, nofollow, noarchive',
};
for (const [name, value] of Object.entries(previewHeaders)) Astro.response.headers.set(name, value);

let unavailable = false;
let authenticated = false;
try {
  const sessionResponse = await fetch(`${apiBase}/api/auth/session`, {
    headers: { Cookie: Astro.request.headers.get('Cookie') ?? '', Accept: 'application/json' },
    cache: 'no-store',
  });
  if (sessionResponse.ok) authenticated = Boolean((await sessionResponse.json()).authenticated);
  else if (sessionResponse.status >= 500) unavailable = true;
} catch { unavailable = true; }
if (!unavailable && !authenticated) {
  return new Response(null, { status: 302, headers: { ...previewHeaders, Location: '/feed/' } });
}
if (unavailable) Astro.response.status = 503;

const entries = authenticated ? await getCollection('learn') : [];
const entry = entries.find((candidate) => candidate.data.slug === Astro.params.slug);
if (authenticated && !entry) Astro.response.status = 404;
const note = entry ? noteFromEntry(entry) : null;
const Content = entry ? (await render(entry)).Content : null;
---

<Base title={note ? `${note.title} · Private Preview` : 'Learn Private Preview'} description={note?.excerpt ?? '私有 Learn 内容预览。'}>
  <meta slot="head" name="robots" content="noindex,nofollow,noarchive" />
  {unavailable ? (
    <main class="learn-page learn-private-state" data-canvas="content"><h1>预览服务暂时不可用</h1><p>认证服务暂时不可用，请稍后重试。</p></main>
  ) : !note || !Content ? (
    <main class="learn-page learn-private-state" data-canvas="content"><a href="/learn/admin/">← 返回 Learn 管理</a><h1>没有找到这篇 Learn 笔记</h1></main>
  ) : (
    <main class="learn-detail-page" data-canvas="content">
      <LearnNoteView note={note} allNotes={entries.map(noteFromEntry)} Content={Content} preview />
    </main>
  )}
</Base>
