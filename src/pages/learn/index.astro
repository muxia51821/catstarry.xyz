---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import KnowledgeGraph from '../../components/learn/KnowledgeGraph.astro';
import LearnSearch from '../../components/learn/LearnSearch.astro';
import NoteRow from '../../components/learn/NoteRow.astro';
import {
  getActiveTracks,
  getPublishedNotes,
  getRecentKnowledge,
  getTrackNotes,
} from '../../components/learn/learn-data';
import '../../components/learn/learn.css';

const notes = getPublishedNotes(await getCollection('learn'));
const tracks = getActiveTracks(notes);
const recentNotes = getRecentKnowledge(notes);
---

<Base title="Learn" description="选择性公开的 durable knowledge projection。">
  <main class="learn-page" data-canvas="content" data-learn-page>
    <div class="learn-page__shell">
      <header class="learn-opening">
        <nav class="page-home-nav" aria-label="Learn 页面导航">
          <a class="page-home-link learn-page__back" href="/" aria-label="返回星图">
            <span aria-hidden="true">←</span><span>返回星图</span>
          </a>
        </nav>
        <h1>Learn</h1>
        <p class="learn-opening__motto">循此苦旅，可抵繁星。<span>Per aspera ad astra</span></p>
      </header>

      {notes.length === 0 ? (
        <p class="learn-empty-corpus">暂时还没有公开的学习笔记。</p>
      ) : (
        <>
          <section class="learn-knowledge-map" aria-labelledby="learn-map-title">
            <header class="learn-knowledge-map__header">
              <h2 id="learn-map-title">Knowledge Map</h2>
              <LearnSearch notes={notes} />
            </header>
            <nav class="learn-track-directory" aria-label="Learn Tracks">
              {tracks.map((track) => (
                <a href={`/learn/track/${track.slug}/`} data-track-link={track.slug}>
                  <span>{track.name}</span>
                  <span class="learn-track-directory__count" aria-label={`${getTrackNotes(notes, track.slug).length} 篇笔记`}>
                    {getTrackNotes(notes, track.slug).length}
                  </span>
                </a>
              ))}
            </nav>
            <KnowledgeGraph tracks={tracks} notes={notes} />
          </section>

          <section class="learn-recent" aria-labelledby="learn-recent-title">
            <h2 id="learn-recent-title">Recent Knowledge</h2>
            <div class="learn-note-rows">
              {recentNotes.map((note) => <NoteRow note={note} showEvent />)}
            </div>
          </section>
        </>
      )}
    </div>
  </main>
</Base>
