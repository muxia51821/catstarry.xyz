---
export const prerender = false;

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { feedApiBase, publicFeedApiBase } from '../../lib/feed-api';
import { noteFromEntry } from '../../components/learn/learn-data';
import '../../components/learn/learn.css';

const apiBase = feedApiBase(Astro.url.origin);
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');

let unavailable = '';
let authenticated = false;
try {
  const sessionResponse = await fetch(`${apiBase}/api/auth/session`, {
    headers: { Cookie: Astro.request.headers.get('Cookie') ?? '', Accept: 'application/json' },
    cache: 'no-store',
  });
  if (sessionResponse.ok) authenticated = Boolean((await sessionResponse.json()).authenticated);
  else if (sessionResponse.status >= 500) unavailable = '管理服务暂时不可用，请稍后重试。';
} catch {
  unavailable = '管理服务暂时不可用，请稍后重试。';
}
if (!unavailable && !authenticated) return Astro.redirect('/feed/');
if (unavailable) Astro.response.status = 503;

const notes = (authenticated ? await getCollection('learn') : []).map(noteFromEntry)
  .sort((a, b) => Date.parse(b.lastModified) - Date.parse(a.lastModified));
const clientApiBase = publicFeedApiBase();
---

<Base title="Learn 管理" description="学习笔记发布管理。">
  <meta slot="head" name="robots" content="noindex,nofollow,noarchive" />
  <main class="learn-page" data-canvas="content" data-learn-admin data-api-base={clientApiBase}>
    <div class="learn-page__shell">
      <header class="learn-page__header">
        <div>
          <a class="learn-page__back" href="/learn/">← 返回 Learn</a>
          <p class="learn-page__eyebrow">PRIVATE CONTENT CONTROL</p>
          <h1>Learn 管理</h1>
          <p class="learn-page__intro">管理公开学习笔记的发布与撤回。Feed 的新版 Learn 更新事件由后续发布流程接入。</p>
        </div>
        <span class="learn-page__count">{notes.length} NOTES</span>
      </header>

      {unavailable ? (
        <p class="learn-admin-error" role="alert">{unavailable}</p>
      ) : <section class="learn-admin-list" aria-label="学习笔记管理列表">
        {notes.map((note) => (
          <article class="learn-admin-row" data-note-slug={note.slug}>
            <div>
              <p class="learn-page__eyebrow">{note.track} / {note.section ?? 'UNSECTIONED'}</p>
              <h2>{note.title}</h2>
              <p>{note.excerpt}</p>
            </div>
            <div class="learn-admin-row__state">
              <span>{note.draft ? 'Draft' : 'Published'}</span>
              <time datetime={note.lastModified}>{new Date(note.lastModified).toLocaleDateString('zh-CN')}</time>
            </div>
            <div class="learn-admin-row__actions">
              <a href={`/learn/preview/${note.slug}/`}>预览</a>
              <button type="button" data-publication-action={note.draft ? 'publish' : 'retract'}>
                {note.draft ? '发布' : '撤回'}
              </button>
            </div>
            <p class="learn-admin-row__status" data-row-status role="status"></p>
          </article>
        ))}
      </section>}
    </div>
  </main>
</Base>

<script>
  const root = document.querySelector('[data-learn-admin]');
  if (root instanceof HTMLElement) {
    const apiBase = root.dataset.apiBase ?? '';
    const send = async (path, body) => {
      const response = await fetch(`${apiBase}${path}`, {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result?.error?.message ?? `Request failed (${response.status})`);
      return result;
    };

    for (const row of root.querySelectorAll('[data-note-slug]')) {
      if (!(row instanceof HTMLElement)) continue;
      const status = row.querySelector('[data-row-status]');
      const show = (message, error = false) => {
        if (!(status instanceof HTMLElement)) return;
        status.textContent = message;
        status.dataset.error = String(error);
      };
      const action = row.querySelector('[data-publication-action]');
      action?.addEventListener('click', async () => {
        if (!(action instanceof HTMLButtonElement)) return;
        action.disabled = true;
        try {
          await send('/api/learn/publish', { slug: row.dataset.noteSlug, action: action.dataset.publicationAction });
          show('发布适配器已接受；完成仓库变更和生产部署后页面才会更新。');
        } catch (error) { show(error instanceof Error ? error.message : '操作失败', true); }
        finally { action.disabled = false; }
      });
    }
  }
</script>

<style>
  .learn-admin-list { display: grid; gap: var(--space-md); }
  .learn-admin-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-lg); padding: var(--space-xl); border: 1px solid var(--content-hairline); border-radius: var(--radius-content); background: var(--content-surface-card); }
  .learn-admin-row h2 { margin-block: 0 var(--space-sm); font-size: var(--text-xl); }
  .learn-admin-row p { color: var(--content-text-secondary); }
  .learn-admin-row__state { display: grid; align-content: start; gap: var(--space-xs); text-align: end; }
  .learn-admin-row__actions { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: end; gap: var(--space-md); }
  .learn-admin-row__actions > a { display: inline-flex; align-items: center; min-block-size: var(--interaction-hit-size); }
  .learn-admin-row__actions form { display: flex; flex-wrap: wrap; align-items: end; gap: var(--space-sm); }
  .learn-admin-row__actions input { min-block-size: var(--interaction-hit-size); padding: var(--space-sm); }
  .learn-admin-row__actions button { min-block-size: var(--interaction-hit-size); }
  .learn-admin-row__status { grid-column: 1 / -1; min-block-size: 1.5em; margin: 0; }
  .learn-admin-row__status[data-error="true"] { color: #a12d39; }
  .learn-admin-error { padding: var(--space-lg); border: 1px solid #a12d39; color: #a12d39; }
  @media (max-width: 640px) { .learn-admin-row { grid-template-columns: 1fr; } .learn-admin-row__state { text-align: start; } }
</style>
