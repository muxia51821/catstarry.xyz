---
export const prerender = false;

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { readOwnerSession } from '../../lib/server/owner-auth';
import {
  getTrackDefinition,
  lifecycleLabel,
  noteFromEntry,
} from '../../components/learn/learn-data';
import '../../components/learn/learn.css';

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');

let unavailable = '';
const auth = await readOwnerSession(Astro.request);
const authenticated = auth.state === 'authenticated';
if (auth.state === 'unavailable') unavailable = '管理服务暂时不可用，请稍后重试。';
if (auth.state === 'unauthenticated') return Astro.redirect('/feed/');
if (unavailable) Astro.response.status = 503;

const notes = (authenticated ? await getCollection('learn') : []).map(noteFromEntry)
  .sort((a, b) => a.title.localeCompare(b.title, 'zh-CN'));
---

<Base title="Learn 管理" description="管理公开 Learn Note 的预览与状态。">
  <meta slot="head" name="robots" content="noindex,nofollow,noarchive" />
  <main class="learn-page learn-admin-page" data-canvas="content" data-learn-admin>
    <div class="learn-page__shell">
      <header class="learn-admin-header">
        <a class="learn-page__back" href="/learn/">← 返回 Learn</a>
        <nav class="learn-owner-nav" aria-label="内容管理"><a href="/feed/admin/">Feed / Blog 管理</a><a aria-current="page" href="/learn/admin/">Learn 管理</a></nav>
        <h1>Learn 管理</h1>
        <p>管理公开 Learn Note 的预览与状态。</p>
      </header>

      {unavailable ? (
        <p class="learn-admin-error" role="alert">{unavailable}</p>
      ) : (
        <section class="learn-admin-list" aria-label="Learn Note 管理列表">
          {notes.map((note) => {
            const track = getTrackDefinition(note.track);
            return (
              <article class="learn-admin-row" data-note-slug={note.slug}>
                <div>
                  <h2>{note.title}</h2>
                  <p class="learn-admin-row__context">{track.name}{note.section ? ` · ${note.section}` : ''}</p>
                  <p class="learn-admin-row__excerpt">{note.excerpt}</p>
                </div>
                <span class="learn-admin-row__state">{lifecycleLabel(note.state)}</span>
                <a class="learn-admin-row__preview" href={`/learn/preview/${note.slug}/`}>预览</a>
              </article>
            );
          })}
        </section>
      )}
    </div>
  </main>
</Base>
