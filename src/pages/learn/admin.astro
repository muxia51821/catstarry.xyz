---
export const prerender = false;

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LearnLifecycleAdmin, { type LearnAdminEntry } from '../../components/learn/LearnLifecycleAdmin';
import { readOwnerSession } from '../../lib/server/owner-auth';
import {
  getTrackDefinition,
} from '../../components/learn/learn-data';
import { loadOwnerLearnPublications, mergeOwnerLearnNotes } from '../../lib/server/learn-publications';
import '../../components/learn/learn.css';

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');

let unavailable = '';
const auth = await readOwnerSession(Astro.request);
const authenticated = auth.state === 'authenticated';
if (auth.state === 'unavailable') unavailable = '管理服务暂时不可用，请稍后重试。';
if (auth.state === 'unauthenticated') return Astro.redirect('/feed/');
if (unavailable) Astro.response.status = 503;

const sourceEntries = authenticated ? await getCollection('learn') : [];
const records = authenticated ? await loadOwnerLearnPublications(Astro.request) : [];
if (authenticated && !records) {
  unavailable = 'Learn 发布状态暂时无法读取，请稍后重试。';
  Astro.response.status = 503;
}
const recordSlugs = new Set(records?.map((record) => record.slug) ?? []);
const configuredFeedUrl = import.meta.env.FEED_API_URL;
const localPreview = typeof configuredFeedUrl === 'string'
  && ['127.0.0.1', 'localhost', '::1'].includes(new URL(configuredFeedUrl).hostname);
const notes: LearnAdminEntry[] = records ? mergeOwnerLearnNotes(sourceEntries, records)
  .map((note) => ({
    slug: note.slug,
    title: note.title,
    trackLabel: getTrackDefinition(note.track).name,
    section: note.section,
    excerpt: note.excerpt,
    revisedAt: note.revisedAt,
    state: note.state,
    everPublished: recordSlugs.has(note.slug),
  }))
  .sort((a, b) => a.title.localeCompare(b.title, 'zh-CN')) : [];
---

<Base title="Learn 管理" description="管理公开 Learn Note 的预览与状态。">
  <meta slot="head" name="robots" content="noindex,nofollow,noarchive" />
  <main class="learn-page learn-admin-page" data-canvas="content" data-learn-admin>
    <div class="learn-page__shell">
      <header class="learn-admin-header">
        <a class="learn-page__back" href="/learn/">← 返回 Learn</a>
        <nav class="learn-owner-nav" aria-label="内容管理"><a href="/feed/admin/">Feed / Blog 管理</a><a aria-current="page" href="/learn/admin/">Learn 管理</a></nav>
        <h1>Learn 管理</h1>
        <p>管理公开 Learn Note 的预览与状态。</p>
      </header>

      {unavailable ? (
        <p class="learn-admin-error" role="alert">{unavailable}</p>
      ) : (
        <LearnLifecycleAdmin client:load initial={notes} mutationEnabled={!localPreview} />
      )}
    </div>
  </main>
</Base>
