---
import type { ProjectIndexEntry } from './project-data';

interface Props {
  project: ProjectIndexEntry;
}

const { project } = Astro.props;
---

<a
  class="project-card"
  href={project.url}
  target="_blank"
  rel="noreferrer"
  aria-label={`${project.name}，在新窗口打开项目`}
>
  <div class="project-card__visual">
    {project.screenshot ? (
      <img src={project.screenshot} alt={`${project.name} 项目截图`} loading="lazy" />
    ) : (
      <div class="project-card__visual-placeholder" aria-hidden="true"></div>
    )}
  </div>

  <div class="project-card__body">
    <div class="project-card__heading">
      <h2>{project.name}</h2>
      <span aria-hidden="true">↗</span>
    </div>
    <p>{project.description}</p>
    <ul class="project-card__tags" aria-label="技术标签">
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
</a>
