---
import type { LearnNote } from './learn-data';
import { getTrackDefinition } from './learn-data';
import { serializeJsonForInlineScript } from '../../lib/safe-json.mjs';

interface Props { notes: LearnNote[]; }
const { notes } = Astro.props;
const searchNotes = notes.map((note) => ({ ...note, trackName: getTrackDefinition(note.track).name }));
const searchJson = serializeJsonForInlineScript(searchNotes);
---

<form class="learn-search" role="search" data-learn-search onsubmit="return false">
  <label class="visually-hidden" for="learn-search-input">搜索学习笔记</label>
  <div class="learn-search__field">
    <input
      id="learn-search-input"
      type="search"
      placeholder="搜索 Learn"
      autocomplete="off"
      aria-controls="learn-search-suggestions"
      aria-autocomplete="list"
      aria-expanded="false"
      role="combobox"
    />
    <span aria-hidden="true">⌕</span>
  </div>
  <div id="learn-search-suggestions" class="learn-search__suggestions" role="listbox" hidden></div>
  <script type="application/json" data-search-index set:html={searchJson}></script>
</form>

<script>
  for (const root of document.querySelectorAll('[data-learn-search]')) {
    if (!(root instanceof HTMLFormElement)) continue;
    const input = root.querySelector('input');
    const suggestions = root.querySelector('.learn-search__suggestions');
    const indexNode = root.querySelector('[data-search-index]');
    if (!(input instanceof HTMLInputElement) || !(suggestions instanceof HTMLElement)) continue;
    const notes = JSON.parse(indexNode?.textContent ?? '[]');
    let active = -1;
    const normalize = (value) => String(value ?? '').trim().toLocaleLowerCase('zh-CN');
    const matches = (note, query) => [note.title, note.track, note.trackName, note.section, ...(note.tags ?? [])]
      .some((value) => normalize(value).includes(query));
    const clear = () => {
      suggestions.replaceChildren();
      suggestions.hidden = true;
      active = -1;
      input.removeAttribute('aria-activedescendant');
      input.setAttribute('aria-expanded', 'false');
    };
    const update = () => {
      const query = normalize(input.value);
      clear();
      if (!query) return;
      for (const [index, note] of notes.filter((note) => matches(note, query)).slice(0, 5).entries()) {
        const link = document.createElement('a');
        link.href = `/learn/notes/${note.slug}/`;
        link.id = `learn-suggestion-${index}`;
        link.role = 'option';
        const title = document.createElement('strong');
        title.textContent = note.title;
        const context = document.createElement('span');
        context.textContent = [note.trackName, note.section].filter(Boolean).join(' · ');
        link.append(title, context);
        suggestions.append(link);
      }
      suggestions.hidden = suggestions.childElementCount === 0;
      input.setAttribute('aria-expanded', String(suggestions.childElementCount > 0));
    };
    input.addEventListener('input', update);
    input.addEventListener('focus', update);
    input.addEventListener('keydown', (event) => {
      const options = [...suggestions.querySelectorAll('[role="option"]')];
      if ((event.key === 'ArrowDown' || event.key === 'ArrowUp') && options.length) {
        event.preventDefault();
        active = event.key === 'ArrowDown' ? (active + 1) % options.length : (active - 1 + options.length) % options.length;
        options.forEach((option, index) => option.setAttribute('aria-selected', String(index === active)));
        input.setAttribute('aria-activedescendant', options[active].id);
      } else if (event.key === 'Enter' && active >= 0 && options[active] instanceof HTMLAnchorElement) {
        event.preventDefault();
        options[active].click();
      } else if (event.key === 'Escape') {
        clear();
        input.blur();
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !root.contains(event.target)) clear();
    });
  }
</script>
