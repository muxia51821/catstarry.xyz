---
import type { LearnNote } from './learn-data';
import { getTreeRows } from './learn-data';

interface Props {
  notes: LearnNote[];
  currentSlug?: string;
}

const { notes, currentSlug } = Astro.props;
const rows = getTreeRows(notes);
const parentSlugs = new Set(notes.map((note) => note.parentSlug).filter((slug): slug is string => Boolean(slug)));
---

<nav class="learn-tree" data-learn-tree aria-label="学习笔记目录树">
  <p class="learn-tree__label">目录树</p>
  {rows.length > 0 ? (
    <ul>
      {rows.map(({ note, depth }) => (
        <li
          data-tree-row
          data-tree-slug={note.slug}
          data-tree-parent={note.parentSlug ?? ''}
          style={`--tree-depth: ${depth}`}
        >
          {parentSlugs.has(note.slug) && (
            <button
              type="button"
              class="learn-tree__toggle"
              data-tree-toggle={note.slug}
              aria-expanded={depth < 2 ? 'true' : 'false'}
              aria-label={`${depth < 2 ? '收起' : '展开'} ${note.title}`}
            >
              {depth < 2 ? '−' : '+'}
            </button>
          )}
          <a
            href={`/learn/notes/${note.slug}/`}
            class:list={{ 'is-current': note.slug === currentSlug }}
            aria-current={note.slug === currentSlug ? 'page' : undefined}
          >
            {note.title}
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="learn-tree__empty">当前轨道还没有已发布笔记。</p>
  )}
</nav>

<script>
  const tree = document.querySelector('[data-learn-tree]');

  if (tree instanceof HTMLElement) {
    const rows = Array.from(tree.querySelectorAll('[data-tree-row]'));
    const rowBySlug = new Map(rows.map((row) => [row.dataset.treeSlug ?? '', row]));
    const collapsed = new Set();

    const sync = () => {
      for (const row of rows) {
        let parent = row.dataset.treeParent ?? '';
        let hidden = false;
        while (parent) {
          if (collapsed.has(parent)) {
            hidden = true;
            break;
          }
          parent = rowBySlug.get(parent)?.dataset.treeParent ?? '';
        }
        row.hidden = hidden;
      }

      for (const toggle of tree.querySelectorAll('[data-tree-toggle]')) {
        const slug = toggle.getAttribute('data-tree-toggle') ?? '';
        const isOpen = !collapsed.has(slug);
        toggle.setAttribute('aria-expanded', String(isOpen));
        toggle.textContent = isOpen ? '−' : '+';
      }
    };

    for (const toggle of tree.querySelectorAll('[data-tree-toggle]')) {
      toggle.addEventListener('click', () => {
        const slug = toggle.getAttribute('data-tree-toggle') ?? '';
        if (collapsed.has(slug)) collapsed.delete(slug);
        else collapsed.add(slug);
        sync();
      });
    }
    sync();
  }
</script>
