---
import type { TrackDefinition, LearnNote } from './learn-data';

interface Props {
  tracks: TrackDefinition[];
  notes: LearnNote[];
}

const { tracks, notes } = Astro.props;
const graphNotes = notes.slice(0, 200);
const noteBySlug = new Map(graphNotes.map((note) => [note.slug, note]));
const positions = new Map(graphNotes.map((note, index) => {
  const angle = (index / Math.max(graphNotes.length, 1)) * Math.PI * 2 - Math.PI / 2;
  const radius = 24 + (index % 3) * 8;
  return [note.slug, { x: 50 + Math.cos(angle) * radius, y: 50 + Math.sin(angle) * radius }];
}));
const links = graphNotes.flatMap((note) => note.links
  .filter((target) => noteBySlug.has(target))
  .map((target) => ({ source: note.slug, target })));
---

<section class="learn-graph" aria-labelledby="learn-graph-title">
  <div class="learn-graph__copy">
    <p class="learn-page__eyebrow">KNOWLEDGE GRAPH</p>
    <h2 id="learn-graph-title">学习不是一条直线</h2>
    <p>轨道提供入口，笔记之间的关联会在内容积累后逐渐显形。</p>
  </div>

  {graphNotes.length > 0 ? (
    <svg class="learn-graph__map" viewBox="0 0 100 100" role="img" aria-label="学习笔记关系图">
      <g class="learn-graph__links" aria-hidden="true">
        {links.map(({ source, target }) => (
          <line
            x1={positions.get(source)?.x}
            y1={positions.get(source)?.y}
            x2={positions.get(target)?.x}
            y2={positions.get(target)?.y}
          />
        ))}
      </g>
      {graphNotes.map((note) => {
        const position = positions.get(note.slug)!;
        return (
          <a class="learn-graph__node" data-track={note.track} href={`/learn/notes/${note.slug}/`}>
            <circle cx={position.x} cy={position.y} r="4.2" />
            <text x={position.x} y={position.y + 9} text-anchor="middle">{note.title.slice(0, 8)}</text>
            <title>{note.title}：{note.excerpt}</title>
          </a>
        );
      })}
    </svg>
  ) : (
    <div class="learn-graph__empty">
      <span aria-hidden="true">○ — ○ — ○</span>
      <p>发布第一篇学习笔记后，知识图谱会从这里开始生长。</p>
    </div>
  )}

  <span class="learn-graph__count">{notes.length} published notes · {tracks.length} tracks · {links.length} links</span>
</section>
