---
import type { TrackDefinition, LearnNote } from './learn-data';

interface Props {
  tracks: TrackDefinition[];
  notes: LearnNote[];
}

const { tracks, notes } = Astro.props;
const positions = [
  { x: 18, y: 58 },
  { x: 34, y: 30 },
  { x: 50, y: 64 },
  { x: 68, y: 28 },
  { x: 84, y: 58 },
];
---

<section class="learn-graph" aria-labelledby="learn-graph-title">
  <div class="learn-graph__copy">
    <p class="learn-page__eyebrow">KNOWLEDGE GRAPH</p>
    <h2 id="learn-graph-title">学习不是一条直线</h2>
    <p>轨道提供入口，笔记之间的关联会在内容积累后逐渐显形。</p>
  </div>

  {tracks.length > 0 ? (
    <svg class="learn-graph__map" viewBox="0 0 100 100" role="img" aria-label="学习轨道关系图">
      <g class="learn-graph__links" aria-hidden="true">
        {positions.slice(0, Math.max(0, tracks.length - 1)).map((position, index) => {
          const next = positions[index + 1];
          return <line x1={position.x} y1={position.y} x2={next.x} y2={next.y} />;
        })}
      </g>
      {tracks.map((track, index) => {
        const position = positions[index];
        return (
          <a class="learn-graph__node" data-track={track.slug} href={`/learn/track/${track.slug}/#track-notes`}>
            <circle cx={position.x} cy={position.y} r="5" />
            <text x={position.x} y={position.y + 12} text-anchor="middle">{track.name}</text>
            <title>{track.name}：{track.description}</title>
          </a>
        );
      })}
    </svg>
  ) : (
    <div class="learn-graph__empty">
      <span aria-hidden="true">○ — ○ — ○</span>
      <p>发布第一篇学习笔记后，知识图谱会从这里开始生长。</p>
    </div>
  )}

  <span class="learn-graph__count">{notes.length} published notes</span>
</section>
