---
import type { LearnNote } from './learn-data';

interface Props {
  text: string;
  notes: Map<string, LearnNote>;
}

const { text, notes } = Astro.props;
const parts = text.split(/\[\[([^\]]+)\]\]/g);
---

{parts.map((part, index) => {
  if (index % 2 === 0) return part;
  const slug = part.trim();
  const target = notes.get(slug);
  if (!target) return `[[${part}]]`;
  return (
    <span class="learn-wikilink">
      <a
        class="learn-wikilink__link"
        href={`/learn/notes/${target.slug}/`}
        data-wikilink-trigger
        aria-expanded="false"
      >
        {target.title}
      </a>
      <span class="learn-wikilink__preview" data-wikilink-preview hidden>
        <strong>{target.title}</strong>
        <p>{target.excerpt}</p>
        <a href={`/learn/notes/${target.slug}/`}>打开笔记 →</a>
      </span>
    </span>
  );
})}
