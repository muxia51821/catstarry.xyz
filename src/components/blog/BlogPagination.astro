---
import { getPageUrl } from '../../lib/blog';

interface Props {
  basePath: string;
  currentPage: number;
  pageCount: number;
}

const { basePath, currentPage, pageCount } = Astro.props;
---

{pageCount > 1 && (
  <nav class="blog-pagination" aria-label="文章分页">
    {currentPage > 1 ? (
      <a href={getPageUrl(basePath, currentPage - 1)}>← 较新的文章</a>
    ) : null}
    {currentPage < pageCount ? (
      <a href={getPageUrl(basePath, currentPage + 1)}>更早的文章 →</a>
    ) : null}
  </nav>
)}
