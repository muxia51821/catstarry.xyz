---
import '../../styles/blog.css';
import BlogPagination from './BlogPagination.astro';
import BlogPostList from './BlogPostList.astro';
import type { BlogPost } from '../../lib/blog';

interface Props {
  title: string;
  posts: BlogPost[];
  currentPage: number;
  pageCount: number;
  basePath: string;
  showBackLink?: boolean;
}

const { title, posts, currentPage, pageCount, basePath, showBackLink = false } = Astro.props;
---

<main class="blog-page" data-canvas="content">
  <nav class="page-home-nav blog-archive__nav" aria-label="博客页面导航">
    <a class="page-home-link" href="/" aria-label="返回星图">
      <span aria-hidden="true">←</span>
      <span>返回星图</span>
    </a>
  </nav>
  <section class="blog-archive">
    <header class="blog-archive__header">
      <h1>{title}</h1>
      {showBackLink && <a class="blog-article__back" href="/blog/">← 返回全部文章</a>}
    </header>
    <BlogPostList posts={posts} emptyMessage="还没有已发布文章。" />
    <BlogPagination basePath={basePath} currentPage={currentPage} pageCount={pageCount} />
  </section>
</main>
