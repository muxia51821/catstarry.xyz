---
import { formatBlogArchiveDate, getPostUrl, type BlogPost } from '../../lib/blog';
import { getCategoryLabel } from '../../lib/category';

interface Props {
  posts: BlogPost[];
  emptyMessage: string;
}

const { posts, emptyMessage } = Astro.props;
---

{posts.length === 0 ? (
  <p class="blog-empty">{emptyMessage}</p>
) : (
  <div class="blog-post-list">
    {posts.map((post) => (
      <article class="blog-post-entry">
        <time class="blog-post-entry__date" datetime={post.data.date.toISOString().slice(0, 10)}>{formatBlogArchiveDate(post.data.date)}</time>
        <div class="blog-post-entry__content">
          <div class="blog-post-entry__mobile-meta">
            <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatBlogArchiveDate(post.data.date)}</time>
            <a href={`/blog/category/${post.data.category}/`}>{getCategoryLabel(post.data.category)}</a>
          </div>
          <h2><a href={getPostUrl(post)}>{post.data.title}</a></h2>
          <p class="blog-post-entry__description">{post.data.description}</p>
          <a class="blog-post-entry__category" href={`/blog/category/${post.data.category}/`}>{getCategoryLabel(post.data.category)}</a>
        </div>
      </article>
    ))}
  </div>
)}
