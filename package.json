{
  "name": "catstarry.xyz",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "assets:planets": "node scripts/export-planet-webp.mjs",
    "test:planets": "node scripts/planet-asset-contract-test.mjs",
    "test:home": "node --experimental-transform-types --import ./scripts/register-typescript-loader.mjs scripts/home-production-regression.mjs",
    "test:home-copy": "node --experimental-transform-types --import ./scripts/register-typescript-loader.mjs scripts/home-copy-contract-test.mjs",
    "test:home-stage": "node scripts/home-stage-browser-test.mjs",
    "test:home-css": "node scripts/home-css-contract-test.mjs",
    "test:site:browser": "node scripts/site-browser-regression.mjs",
    "test:content-meteor": "node scripts/content-meteor-browser-regression.mjs",
    "test:site-output": "node scripts/site-output-contract-test.mjs",
    "test:feed:password": "node scripts/feed-password-contract-test.mjs",
    "test:feed:page": "node --experimental-transform-types --import ./scripts/register-typescript-loader.mjs scripts/feed-page-contract-test.mjs",
    "test:shared:security": "node --experimental-transform-types --import ./scripts/register-typescript-loader.mjs scripts/shared-security-contract-test.mjs",
    "test:shared:time": "node --experimental-transform-types --import ./scripts/register-typescript-loader.mjs scripts/shanghai-time-contract-test.mjs",
    "test:feed:http": "node --experimental-transform-types --import ./scripts/register-typescript-loader.mjs scripts/feed-http-contract-test.mjs",
    "test:feed:worker": "node scripts/feed-worker-contract-test.mjs",
    "test:feed:ui": "node scripts/feed-ui-regression.mjs",
    "feed:user": "node scripts/feed-user-record.mjs",
    "test:footprints": "node scripts/public-footprint-contract-test.mjs",
    "signal:footprint": "node scripts/public-footprint-signal.mjs",
    "blog:sync-publications": "node scripts/blog-publication-manifest.mjs",
    "test:blog:publications": "node scripts/blog-publication-contract-test.mjs",
    "test:blog:reconciliation": "node scripts/blog-reconciliation-contract-test.mjs",
    "test:blog:preview": "node scripts/blog-preview-contract-test.mjs",
    "test:content-owner-operations": "node --experimental-transform-types --import ./scripts/register-typescript-loader.mjs scripts/content-owner-operations-contract-test.mjs",
    "project:add": "node scripts/project-entry.mjs",
    "project:capture": "node scripts/capture-project-screenshots.mjs",
    "test:projects": "node scripts/project-contract-test.mjs",
    "learn:slug": "node scripts/learn-slug.mjs",
    "learn:import": "node scripts/learn-import.mjs",
    "learn:sync-publications": "node scripts/learn-publication-manifest.mjs",
    "release:scope": "node scripts/publication-release-scope.mjs",
    "release:dispatch-sync": "node scripts/dispatch-production-publication-sync.mjs",
    "release:status": "node scripts/production-status.mjs",
    "test:learn:authoring": "node --experimental-transform-types --import ./scripts/register-typescript-loader.mjs scripts/learn-authoring-contract-test.mjs",
    "test:learn:preview": "node scripts/learn-preview-contract-test.mjs",
    "test:release:scope": "node scripts/publication-release-scope-contract-test.mjs",
    "test:preview:local": "node scripts/local-preview.mjs --smoke-only",
    "test:preview:lifecycle": "node scripts/local-preview-lifecycle-test.mjs",
    "preview:local": "node scripts/local-preview.mjs",
    "preview:stop": "node scripts/local-preview.mjs --stop",
    "test:migrations": "node scripts/d1-migration-contract-test.mjs",
    "test:ci": "node scripts/ci-contract-test.mjs",
    "test:contracts": "npm run test:feed:password && npm run test:feed:page && npm run test:shared:security && npm run test:shared:time && npm run test:feed:http && npm run test:footprints && npm run test:blog:publications && npm run test:content-owner-operations && npm run test:projects && npm run test:learn:authoring && npm run test:release:scope && npm run test:migrations && npm run test:ci",
    "test:browser:ci": "npm run test:site:browser && npm run test:content-meteor && npm run test:home && npm run test:home-stage",
    "site:typecheck": "tsc --project tsconfig.json --noEmit",
    "preview": "astro preview",
    "worker:config": "node scripts/validate-worker-config.mjs",
    "worker:types:feed": "wrangler types workers/feed-api/worker-configuration.d.ts --config workers/feed-api/wrangler.jsonc && node scripts/normalize-worker-types.mjs workers/feed-api/worker-configuration.d.ts",
    "worker:types": "npm run worker:types:feed",
    "worker:types:check:feed": "wrangler types workers/feed-api/.worker-configuration.check.d.ts --config workers/feed-api/wrangler.jsonc && node scripts/check-generated-worker-types.mjs workers/feed-api/worker-configuration.d.ts workers/feed-api/.worker-configuration.check.d.ts",
    "worker:types:check": "npm run worker:types:check:feed",
    "worker:typecheck:feed": "tsc --project workers/feed-api/tsconfig.json --noEmit",
    "worker:typecheck": "npm run worker:typecheck:feed",
    "worker:migrate:local:feed": "wrangler d1 migrations apply catstarry-db --local --config workers/feed-api/wrangler.jsonc",
    "worker:migrate:local": "npm run worker:migrate:local:feed",
    "worker:migrate:local:repeat": "npm run worker:migrate:local && npm run worker:migrate:local",
    "worker:dry-run:feed": "wrangler deploy --dry-run --config workers/feed-api/wrangler.jsonc",
    "worker:dry-run:site": "wrangler deploy --dry-run --config dist/server/wrangler.json",
    "worker:dry-run": "npm run worker:dry-run:feed && npm run worker:dry-run:site",
    "worker:validate": "npm run worker:config && npm run worker:types:check && npm run worker:typecheck && npm run worker:dry-run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.4",
    "@astrojs/react": "^6.0.1",
    "@giscus/react": "^3.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "7.1.3",
    "bcryptjs": "3.0.3",
    "gsap": "3.13.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "jsonc-parser": "3.3.1",
    "sharp": "0.34.5",
    "typescript": "7.0.2",
    "wrangler": "4.113.0"
  }
}
