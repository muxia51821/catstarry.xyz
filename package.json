{
  "name": "catstarry.xyz",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test:home": "node scripts/home-production-regression.mjs",
    "preview": "astro preview",
    "worker:config": "node scripts/validate-worker-config.mjs",
    "worker:types:feed": "wrangler types workers/feed-api/worker-configuration.d.ts --config workers/feed-api/wrangler.jsonc && node scripts/normalize-worker-types.mjs workers/feed-api/worker-configuration.d.ts",
    "worker:types:finance": "wrangler types workers/finance-api/worker-configuration.d.ts --config workers/finance-api/wrangler.jsonc && node scripts/normalize-worker-types.mjs workers/finance-api/worker-configuration.d.ts",
    "worker:types": "npm run worker:types:feed && npm run worker:types:finance",
    "worker:types:check:feed": "wrangler types workers/feed-api/.worker-configuration.check.d.ts --config workers/feed-api/wrangler.jsonc && node scripts/check-generated-worker-types.mjs workers/feed-api/worker-configuration.d.ts workers/feed-api/.worker-configuration.check.d.ts",
    "worker:types:check:finance": "wrangler types workers/finance-api/.worker-configuration.check.d.ts --config workers/finance-api/wrangler.jsonc && node scripts/check-generated-worker-types.mjs workers/finance-api/worker-configuration.d.ts workers/finance-api/.worker-configuration.check.d.ts",
    "worker:types:check": "npm run worker:types:check:feed && npm run worker:types:check:finance",
    "worker:typecheck:feed": "tsc --project workers/feed-api/tsconfig.json --noEmit",
    "worker:typecheck:finance": "tsc --project workers/finance-api/tsconfig.json --noEmit",
    "worker:typecheck": "npm run worker:typecheck:feed && npm run worker:typecheck:finance",
    "worker:migrate:local:feed": "wrangler d1 migrations apply catstarry-db --local --config workers/feed-api/wrangler.jsonc",
    "worker:migrate:local:finance": "wrangler d1 migrations apply finance-db --local --config workers/finance-api/wrangler.jsonc",
    "worker:migrate:local": "npm run worker:migrate:local:feed && npm run worker:migrate:local:finance",
    "worker:dry-run:feed": "wrangler deploy --dry-run --config workers/feed-api/wrangler.jsonc",
    "worker:dry-run:finance": "wrangler deploy --dry-run --config workers/finance-api/wrangler.jsonc",
    "worker:dry-run": "npm run worker:dry-run:feed && npm run worker:dry-run:finance",
    "worker:validate": "npm run worker:config && npm run worker:types:check && npm run worker:typecheck && npm run worker:dry-run"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@giscus/react": "^3.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "7.0.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "4.113.0"
  }
}
