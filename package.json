{
  "name": "catstarry-xyz",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "worker:dev": "wrangler dev --config workers/feed-api/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config workers/feed-api/wrangler.jsonc",
    "worker:deploy:feed": "wrangler deploy --config workers/feed-api/wrangler.jsonc",
    "worker:deploy:finance": "wrangler deploy --config workers/finance-api/wrangler.jsonc",
    "worker:deploy:dry": "wrangler deploy --dry-run --config workers/feed-api/wrangler.jsonc",
    "worker:deploy:dry:finance": "wrangler deploy --dry-run --config workers/finance-api/wrangler.jsonc",
    "worker:dry-run": "npm run worker:deploy:dry && npm run worker:deploy:dry:finance && npm run site:deploy:dry",
    "site:deploy:dry": "wrangler deploy --dry-run --config wrangler.jsonc",
    "worker:migrate:local": "wrangler d1 migrations apply catstarry-finance --local --config workers/finance-api/wrangler.jsonc",
    "worker:migrate:remote": "wrangler d1 migrations apply catstarry-finance --remote --config workers/finance-api/wrangler.jsonc",
    "worker:migrate:local:repeat": "npm run worker:migrate:local && npm run worker:migrate:local",
    "worker:config": "node scripts/validate-worker-config.mjs",
    "worker:types:feed": "wrangler types workers/feed-api/worker-configuration.d.ts --config workers/feed-api/wrangler.jsonc && node scripts/normalize-worker-types.mjs workers/feed-api/worker-configuration.d.ts",
    "worker:types:finance": "wrangler types workers/finance-api/worker-configuration.d.ts --config workers/finance-api/wrangler.jsonc && node scripts/normalize-worker-types.mjs workers/finance-api/worker-configuration.d.ts",
    "worker:types": "npm run worker:types:feed && npm run worker:types:finance",
    "worker:types:check:feed": "wrangler types workers/feed-api/.worker-configuration.check.d.ts --config workers/feed-api/wrangler.jsonc && node scripts/check-generated-worker-types.mjs workers/feed-api/worker-configuration.d.ts workers/feed-api/.worker-configuration.check.d.ts",
    "worker:types:check:finance": "wrangler types workers/finance-api/.worker-configuration.check.d.ts --config workers/finance-api/wrangler.jsonc && node scripts/check-generated-worker-types.mjs workers/finance-api/worker-configuration.d.ts workers/finance-api/.worker-configuration.check.d.ts",
    "worker:types:check": "npm run worker:types:check:feed && npm run worker:types:check:finance",
    "worker:typecheck": "tsc --project workers/feed-api/tsconfig.json --noEmit && tsc --project workers/finance-api/tsconfig.json --noEmit",
    "site:typecheck": "tsc --project tsconfig.json --noEmit",
    "test:feed:password": "node scripts/feed-password-contract-test.mjs",
    "test:feed:page": "node scripts/feed-page-contract-test.mjs",
    "test:feed:http": "node scripts/feed-http-contract-test.mjs",
    "test:feed:worker": "node scripts/feed-worker-regression.mjs",
    "test:shared:security": "node scripts/shared-security-contract-test.mjs",
    "test:footprints": "node scripts/feed-footprint-regression.mjs",
    "test:blog:publications": "node scripts/blog-publication-contract-test.mjs",
    "test:content-owner-operations": "node scripts/content-owner-operations-contract-test.mjs",
    "test:projects": "node scripts/projects-contract-test.mjs",
    "test:learn:authoring": "node scripts/learn-authoring-contract-test.mjs",
    "test:finance:calculations": "node scripts/finance-calculation-contract-test.mjs",
    "test:finance:activity": "node --experimental-transform-types --import ./scripts/register-typescript-loader.mjs scripts/finance-activity-query-contract.mjs",
    "test:finance:account-state": "node --experimental-transform-types --import ./scripts/register-typescript-loader.mjs scripts/finance-account-state-contract.mjs",
    "test:finance:asset-history": "node scripts/finance-asset-history-contract.mjs && node --experimental-transform-types --import ./scripts/register-typescript-loader.mjs scripts/finance-asset-valuation-rebuild-contract.mjs",
    "test:finance:operations": "node --experimental-transform-types --import ./scripts/register-typescript-loader.mjs scripts/finance-operation-history-query-contract.mjs",
    "test:finance:audit-atomicity": "node scripts/finance-core-audit-atomicity-contract.mjs",
    "test:finance:operations-ui": "node scripts/finance-operation-history-ui-regression.mjs",
    "test:finance:ui": "node scripts/finance-ui-regression.mjs",
    "finance:preview": "node scripts/finance-preview.mjs",
    "finance:preview:history": "node scripts/finance-preview-history.mjs",
    "test:preview:local": "node scripts/local-preview.mjs --smoke-only",
    "test:preview:lifecycle": "node scripts/local-preview-lifecycle-test.mjs",
    "preview:local": "node scripts/local-preview.mjs",
    "preview:stop": "node scripts/local-preview.mjs --stop",
    "test:finance:preview": "node scripts/finance-preview-contract-test.mjs",
    "finance:user": "node scripts/finance-user-record.mjs",
    "finance:import": "node scripts/finance-import.mjs",
    "finance:import:snapshots": "node scripts/finance-import-snapshots.mjs",
    "finance:import:workbook": "python scripts/finance-import-workbook.py",
    "test:finance:site": "node scripts/finance-site-contract-test.mjs",
    "test:finance:import": "node scripts/finance-import-contract-test.mjs",
    "test:finance:import:snapshots": "node scripts/finance-import-snapshots-contract-test.mjs",
    "test:finance:workbook-import": "node scripts/finance-workbook-import-contract-test.mjs",
    "test:finance:history-import": "node scripts/finance-history-import-contract-test.mjs",
    "test:finance:xlsx": "node --experimental-transform-types --import ./scripts/register-typescript-loader.mjs scripts/finance-xlsx-contract-test.mjs",
    "test:finance:http": "node --experimental-transform-types --import ./scripts/register-typescript-loader.mjs scripts/finance-http-contract-test.mjs",
    "test:finance:market": "node --experimental-transform-types --import ./scripts/register-typescript-loader.mjs scripts/finance-market-contract-test.mjs",
    "test:finance:periods": "node --experimental-transform-types --import ./scripts/register-typescript-loader.mjs scripts/finance-periods-contract-test.mjs",
    "test:finance:concurrency": "node --experimental-transform-types --import ./scripts/register-typescript-loader.mjs scripts/finance-concurrency-contract-test.mjs",
    "test:migrations": "node scripts/d1-migration-contract-test.mjs",
    "test:ci": "node scripts/ci-contract-test.mjs",
    "test:contracts": "npm run test:feed:password && npm run test:feed:page && npm run test:shared:security && npm run test:feed:http && npm run test:footprints && npm run test:blog:publications && npm run test:content-owner-operations && npm run test:projects && npm run test:learn:authoring && npm run test:finance:calculations && npm run test:finance:periods && npm run test:finance:concurrency && npm run test:finance:audit-atomicity && npm run test:finance:activity && npm run test:finance:account-state && npm run test:finance:asset-history && npm run test:finance:operations && npm run test:finance:site && npm run test:finance:import && npm run test:finance:import:snapshots && npm run test:finance:workbook-import && npm run test:finance:history-import && npm run test:finance:xlsx && npm run test:finance:http && npm run test:finance:market && npm run test:migrations && npm run test:ci",
    "test:browser:ci": "npm run test:finance:operations-ui && npm run test:finance:ui && npm run test:site:browser && npm run test:content-meteor && npm run test:home && npm run test:home-stage"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.0",
    "@astrojs/react": "^5.0.7",
    "@cloudflare/workers-types": "^4.20260815.0",
    "@tailwindcss/vite": "^4.1.12",
    "astro": "^7.0.9",
    "lucide-react": "^0.539.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.1.12",
    "wrangler": "^4.31.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.9.2"
  }
}
